{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://employee-system-api-jet.vercel.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://employee-system-api-jet.vercel.app/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
