# ==============================================================================
# Employee Management System - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and update the values for your environment.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=5000

# Client Application URL (used for CORS and Password Reset Links)
CLIENT_URL=http://localhost:5173

# Database Connection (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=employee_db

# Security & JSON Web Tokens
# Must be a cryptographically strong, random string (min 32 characters in production)
JWT_SECRET=replace_with_a_long_cryptographically_secure_random_key_min_32_chars

# Rate Limiting (Optional overrides)
# RATE_LIMIT_MAX_PER_15_MIN=600
# AUTH_RATE_LIMIT_MAX_PER_15_MIN=30

# Email Delivery Configuration (Optional - for Password Resets & Alerts)
# To use Gmail SMTP, generate a 16-character Google App Password:
# https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Employee Management System <your_email@example.com>"
